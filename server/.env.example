# Copy this file to server/.env and fill in real values.
# server/.env is gitignored on purpose — never commit real secrets here.

# Pick any string yourself. Must be identical here and in Meta's
# "Configure Webhooks" screen. This one is already generated for you:
WHATSAPP_VERIFY_TOKEN=arennode_wh_05f93650304ac591b6

# Meta App Dashboard -> App Settings -> Basic -> App Secret. Verifies the
# X-Hub-Signature-256 on inbound webhook POSTs. NOT sent by Fast2SMS — see the
# BSP block below for how the webhook authenticates in that mode.
WHATSAPP_APP_SECRET=

# The Phone Number ID you send FROM. For a direct Meta app: Meta App Dashboard
# -> WhatsApp -> API Setup. For Fast2SMS: the `phone_number_id` its "Get WABA
# & Template Details" call returns (run `npm run check:whatsapp` to see it).
WHATSAPP_PHONE_NUMBER_ID=

# Direct-Meta access token. Leave BLANK when going through Fast2SMS.
WHATSAPP_ACCESS_TOKEN=

# ── BSP: Fast2SMS ─────────────────────────────────────────────────────────
# Fast2SMS's WhatsApp API is a passthrough of Meta's Cloud API, so the send
# path, meta.js and the webhook parser are all shared. Setting this key routes
# every send through Fast2SMS instead of graph.facebook.com (the key rides
# RAW in the Authorization header — client.js handles that). It does NOT by
# itself make sends go live — that still needs MESSAGING_PROVIDER=fast2sms
# below, on purpose, so you can run the read-only `npm run check:whatsapp`
# with just the key set and no risk to a freshly-approved number.
FAST2SMS_API_KEY=

# Optional. Fast2SMS's docs use v26.0; the direct-Meta path defaults to v21.0.
# Override either here.
WHATSAPP_GRAPH_VERSION=

# Fast2SMS does not sign webhook POSTs. If set, every inbound webhook POST
# must carry this string as ?token=... on the URL — put the same value in the
# Fast2SMS dashboard's webhook URL. Configure that webhook in "META DIRECT"
# format so its payload matches what the server already parses.
WHATSAPP_WEBHOOK_TOKEN=

# Same Supabase project the main app already uses.
SUPABASE_URL=https://ieimvjprtltancxapuzg.supabase.co
# Project Settings -> API -> service_role (NOT the anon key)
SUPABASE_SERVICE_ROLE_KEY=

PORT=4000

# ── Messaging provider ─────────────────────────────────────────────────────
# "fast2sms", "meta", or "mock". Leave UNSET to choose automatically: "meta"
# when WHATSAPP_PHONE_NUMBER_ID + WHATSAPP_ACCESS_TOKEN are present, "mock"
# otherwise. "fast2sms" is NEVER auto-selected — going live through the BSP is
# an explicit choice you make here once `npm run check:whatsapp` shows the
# number healthy and the templates Approved. Naming a provider explicitly is
# never second-guessed — asking for one without its credentials errors rather
# than silently pretending messages were delivered.
MESSAGING_PROVIDER=

# Approved template names in Meta's WhatsApp Manager. These are Meta's names,
# not ours, and change when a template is re-approved — which is why they are
# configuration and not code.
WHATSAPP_TEMPLATE_PRESCRIPTION=aren_prescription
WHATSAPP_TEMPLATE_FOLLOW_UP=aren_follow_up
WHATSAPP_TEMPLATE_LANG=en_US

# Fraction of mock sends that fail on purpose, 0–1. Set to e.g. 0.2 for an
# afternoon to exercise the refund path, which nothing else can reach.
MESSAGING_MOCK_FAILURE_RATE=0

# ── Zoho Mail (operational email) ──────────────────────────────────────────
# India data centre. A token from accounts.zoho.in works ONLY against
# accounts.zoho.in / mail.zoho.in — the .com hosts reject it with
# INVALID_OAUTHTOKEN, which looks like a bad credential and is not one.
# NEVER prefix any of these with VITE_ — that ships them in the browser bundle.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Not a secret — the Zoho account id.
ZOHO_ACCOUNT_ID=6202294000000002002
# Must be a mailbox the account owns, or a confirmed alias of one.
ZOHO_FROM=care@arenode.com

# Where operational email lands. Point it at yourself while developing.
SUPPORT_NOTIFY_EMAIL=support@arenode.com
