# Copy this file to server/.env and fill in real values.
# server/.env is gitignored on purpose — never commit real secrets here.

# Pick any string yourself. Must be identical here and in Meta's
# "Configure Webhooks" screen. This one is already generated for you:
WHATSAPP_VERIFY_TOKEN=arennode_wh_05f93650304ac591b6

# Meta App Dashboard -> App Settings -> Basic -> App Secret
WHATSAPP_APP_SECRET=

# Meta App Dashboard -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Same Supabase project the main app already uses.
SUPABASE_URL=https://ieimvjprtltancxapuzg.supabase.co
# Project Settings -> API -> service_role (NOT the anon key)
SUPABASE_SERVICE_ROLE_KEY=

PORT=4000

# ── Messaging provider ─────────────────────────────────────────────────────
# "meta" or "mock". Leave UNSET to choose automatically: Meta when the two
# WHATSAPP_ values above are present, the mock adapter otherwise. Naming a
# provider explicitly is never second-guessed — asking for meta without
# credentials errors rather than silently pretending messages were delivered.
MESSAGING_PROVIDER=

# Approved template names in Meta's WhatsApp Manager. These are Meta's names,
# not ours, and change when a template is re-approved — which is why they are
# configuration and not code.
WHATSAPP_TEMPLATE_PRESCRIPTION=aren_prescription
WHATSAPP_TEMPLATE_FOLLOW_UP=aren_follow_up
WHATSAPP_TEMPLATE_LANG=en_US

# Fraction of mock sends that fail on purpose, 0–1. Set to e.g. 0.2 for an
# afternoon to exercise the refund path, which nothing else can reach.
MESSAGING_MOCK_FAILURE_RATE=0

# ── Zoho Mail (operational email) ──────────────────────────────────────────
# India data centre. A token from accounts.zoho.in works ONLY against
# accounts.zoho.in / mail.zoho.in — the .com hosts reject it with
# INVALID_OAUTHTOKEN, which looks like a bad credential and is not one.
# NEVER prefix any of these with VITE_ — that ships them in the browser bundle.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Not a secret — the Zoho account id.
ZOHO_ACCOUNT_ID=6202294000000002002
# Must be a mailbox the account owns, or a confirmed alias of one.
ZOHO_FROM=care@arenode.com

# Where operational email lands. Point it at yourself while developing.
SUPPORT_NOTIFY_EMAIL=support@arenode.com
